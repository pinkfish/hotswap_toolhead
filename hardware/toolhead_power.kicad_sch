  (text "24V CAN heater/fan controller - power board - generated from design.py. Each pin connects through a net label." (exclude_from_sim no) (at 15.24 12.7 0) (effects (font (size 1.778 1.778)) (justify left bottom)) (uuid "da3e215e-7c6c-4c3b-8784-800a7f513690"))
  (text "J4 is the board-to-board link to the logic board: pin n there carries the same net as pin n here (pin 12 is TH_RTN here, a GND pin on the logic board)." (exclude_from_sim no) (at 15.24 16.51 0) (effects (font (size 1.778 1.778)) (justify left bottom)) (uuid "42d1b237-e81c-4273-a5e4-43ba25b7a25a"))
